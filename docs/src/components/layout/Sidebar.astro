---
import { navigation } from '../../config/navigation';
import { docHref } from '../../lib/navigation';

interface Props {
  currentSlug: string;
}
const { currentSlug } = Astro.props;
---

<nav class="sidebar" data-sidebar aria-label="Documentation">
  {
    navigation.map((group) => (
      <section class="sidebar__group">
        <h2 class="sidebar__label">{group.label}</h2>
        <ul class="sidebar__list">
          {group.items.map((item) => (
            <li>
              <a
                class="sidebar__link"
                href={docHref(item.slug)}
                aria-current={item.slug === currentSlug ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  .sidebar {
    position: sticky;
    top: var(--layout-bar-h);
    align-self: start;
    height: calc(100vh - var(--layout-bar-h));
    overflow-y: auto;
    padding: var(--space-8) var(--space-4) var(--space-20) var(--space-6);
    border-right: var(--border-width) solid var(--color-border-strong);
  }

  .sidebar__group + .sidebar__group {
    margin-top: var(--space-6);
  }

  .sidebar__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 var(--space-3) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-faint);
  }
  .sidebar__label::before {
    content: '';
    width: 12px;
    height: 1px;
    background: var(--color-accent);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar__link {
    display: block;
    padding: 6px var(--space-3);
    border-left: 2px solid transparent;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      padding-left var(--dur) var(--ease);
  }
  .sidebar__link:hover {
    color: var(--color-text);
    border-left-color: var(--color-border-strong);
    padding-left: var(--space-4);
  }
  .sidebar__link[aria-current='page'] {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  @media (max-width: 900px) {
    .sidebar {
      position: fixed;
      top: var(--layout-bar-h);
      left: 0;
      width: 300px;
      max-width: 85vw;
      background: var(--color-bg);
      z-index: var(--z-nav);
      transform: translateX(-110%);
      transition: transform var(--dur) var(--ease);
    }
    .sidebar.is-open {
      transform: translateX(0);
    }
  }
</style>
