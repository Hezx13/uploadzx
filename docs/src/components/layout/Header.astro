---
import { site } from '../../config/site';
import { firstDocSlug } from '../../config/navigation';
import { docHref } from '../../lib/navigation';

interface Props {
  showMenu?: boolean;
}
const { showMenu = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="header">
  {
    showMenu && (
      <button class="header__menu" data-sidebar-toggle aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
    )
  }

  <a class="header__brand" href={base}>
    <span class="header__logo">u</span>
    <span class="header__name">{site.name}</span>
    <span class="header__ver">v{site.version}</span>
  </a>

  <div class="header__spacer"></div>

  <nav class="header__links">
    <a class="link-underline header__hide-sm" href={docHref(firstDocSlug)}>Docs</a>
    <a class="link-underline" href={site.links.github} target="_blank" rel="noopener">GitHub</a>
    <a class="link-underline header__hide-sm" href={site.links.npm} target="_blank" rel="noopener">
      npm
    </a>
  </nav>

  <button class="header__icon" data-theme-toggle aria-label="Toggle theme">●</button>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--layout-bar-h);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0 var(--space-5);
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border-strong);
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .header__logo {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 17px;
  }
  .header__name {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--fs-md);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }
  .header__ver {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    border: var(--border-width) solid var(--color-border);
    padding: 2px 7px;
  }

  .header__spacer {
    flex: 1;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .header__links a {
    color: var(--color-text-muted);
  }

  .header__icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: var(--border-width) solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 14px;
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .header__icon:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  /* Mobile menu (hamburger) */
  .header__menu {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 38px;
    height: 38px;
    border: var(--border-width) solid var(--color-border-strong);
    background: var(--color-bg);
    cursor: pointer;
    padding: 0 9px;
  }
  .header__menu span {
    height: 2px;
    background: var(--color-text);
  }

  @media (max-width: 900px) {
    .header__menu {
      display: flex;
    }
    .header__hide-sm {
      display: none;
    }
  }
</style>
