---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// Only surface section (h2) and subsection (h3) headings.
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <aside class="toc" aria-label="On this page">
      <p class="toc__title">On this page</p>
      <ul class="toc__list">
        {items.map((h) => (
          <li class:list={['toc__item', { 'toc__item--sub': h.depth === 3 }]}>
            <a class="toc__link" href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .toc {
    position: sticky;
    top: calc(var(--layout-bar-h) + var(--space-12));
    align-self: start;
    max-height: calc(100vh - var(--layout-bar-h) - var(--space-16));
    overflow-y: auto;
  }
  .toc__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-faint);
  }
  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: var(--border-width) solid var(--color-border);
  }
  .toc__item--sub .toc__link {
    padding-left: var(--space-6);
  }
  .toc__link {
    display: block;
    padding: 4px var(--space-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--color-text-faint);
    font-size: var(--fs-sm);
    line-height: 1.4;
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .toc__link:hover {
    color: var(--color-text);
  }
  .toc__link.is-active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  @media (max-width: 1100px) {
    .toc {
      display: none;
    }
  }
</style>
